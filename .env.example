# Asuna Backend Environment Configuration

# Required: Your Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (default: 3848)
PORT=3848

# WhatsApp Bot API URL (for proactive triggers)
# On the same droplet, use localhost. Adjust if running elsewhere.
BOT_URL=http://127.0.0.1:3847

# Isolated research API, cron disabled, automatic WhatsApp messages suppressed.
# The offline evaluator needs neither these settings nor a Gemini key.
ASUNA_RESEARCH_MODE=false
RESEARCH_API_TOKEN=
# Optional absolute or relative path. Research default: data/research; normal: data.
# ASUNA_DATA_DIR=./data/research
# Disable automatic notifications independently of research mode:
ASUNA_PROACTIVE_ENABLED=true
